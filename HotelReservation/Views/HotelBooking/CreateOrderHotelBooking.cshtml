@using HotelReservation.Models.Hotel
@model List<hotelViewModel>

@{
    Layout = "~/Views/Shared/_LayoutHotel.cshtml";
}

@section Styles{
    <link href="~/css/Hotel/hotelBookingSpeical.css" rel="stylesheet" />
}
<a href="/HotelBooking/CreateOrderHotelBooking">HotelBooking</a>


<div class="hotels">
    @foreach (var hotel in Model)
    {
        <div class="hotel">
            <div class="name">
                @hotel.Name
            </div>
            <div class="image-container">
                <img src="@hotel.Src" />
            </div>
            <div class="buttons">
                <div class="button">
                    Забронировать
                </div>
                <div class="price">
                    170000 руб
                </div>
            </div>
        </div>
    }
</div>


